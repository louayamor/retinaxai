APP_ENV=development
APP_NAME=retinaxai-llmops
APP_VERSION=0.1.0

RETINAXAI_BASE_DIR=/home/louay/RetinaXAI

# Inter-service
BACKEND_SERVICE_URL=http://localhost:8000
TIMEOUT_SECONDS=60

# Local storage only
DATA_DIR=/home/louay/RetinaXAI/llmops-service/llmops-service/data
CACHE_DIR=/home/louay/RetinaXAI/llmops-service/llmops-service/data/cache

# LLM Configuration
LLM_PROVIDER=github
LLM_MODEL=openai/gpt-4.1-mini
GITHUB_ACCESS_TOKEN=your_github_token_here

# MLflow / DagsHub
MLFLOW_TRACKING_URI=https://dagshub.com/louayamor/retinaxai.mlflow
MLFLOW_EXPERIMENT_NAME=retinaxai-llmops

# Prometheus metrics
PROMETHEUS_METRICS_PORT=9092

# RAG embeddings (optional)
# If your environment has no internet/DNS, enable offline mode and provide a local model dir.
# Example local path: /home/louay/.cache/huggingface/hub/models--sentence-transformers--all-MiniLM-L6-v2/snapshots/<hash>
RAG_EMBEDDINGS_OFFLINE=false
# RAG_EMBEDDING_MODEL_PATH=
# RAG_HF_HOME=

LOG_LEVEL=INFO
